PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,https://fleetparlour.com.au,https://www.fleetparlour.com.au
DATABASE_PATH=./data/fleet-parlour.sqlite
UPLOAD_DIR=./data/uploads
MAX_FILE_MB=8
MAX_FILES=10
ADMIN_API_KEY=change-this-to-a-long-random-secret

# Zoho SMTP notification. Leave SMTP_PASS blank until you are ready.
SMTP_HOST=smtp.zoho.com.au
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@fleetparlour.com.au
SMTP_PASS=
NOTIFY_TO=info@fleetparlour.com.au
NOTIFY_FROM=Fleet Parlour Website <info@fleetparlour.com.au>

# Live social follower / like counters
# Counts are refreshed server-side and cached. Never place these secrets in website JS/HTML.
SOCIAL_STATS_CACHE_MINUTES=30

# Meta / Facebook
# META_ACCESS_TOKEN is the Facebook Page/Meta token used only for Facebook.
META_GRAPH_VERSION=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Instagram API with Instagram Login
# Keep the Instagram token separate from the Facebook token.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# TikTok Login Kit / Display API
# Only the user access token is required by TikTok API v2 for this endpoint.
# The authorised token must include user.info.stats. No TikTok user ID/open_id is required.
TIKTOK_ACCESS_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
